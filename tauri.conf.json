{
  "productName": "Evo75 KeyLab",
  "version": "0.2.0",
  "identifier": "io.github.ericantoine.evo75keylab",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Evo75 KeyLab",
        "width": 1160,
        "height": 815,
        "minWidth": 700,
        "minHeight": 550,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        {
          "identifier": "atelier",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
